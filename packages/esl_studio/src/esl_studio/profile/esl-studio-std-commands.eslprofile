<?xml version="1.0" ?>

<esl-studio-std-commands>

	<esl-studio>

		<commands>

			<command name="New Application" procedure="NewApplication">Creates a new ESL-Studio application</command>
			<command name="Open Application" procedure="OpenApplication">Opens an existing ESL-Studio application</command>
			<command name="Save Application" procedure="SaveApplication">Saves the current ESL-Studio application with the same filename</command>
			<command name="Save Application As" procedure="SaveApplicationAs">Saves the current ESL-Studio application with a new filename</command>
			<command name="Import From ISE" procedure="ImportFromISE">Imports a simulation application from (legacy) ESL-ISE</command>

			<command name="Print/Save Diagram" procedure="PrintSaveDiagram">Opens the Print/Save Diagram dialog to setup an area of the current diagram view to print or save as an image</command>
			<command name="Page Setup" procedure="PageSetup">Opens the standard Page Setup dialog to set the page settings for printing</command>
			<command name="Print Preview" procedure="PrintPreview">Shows a preview printout for the current diagram or text view</command>
			<command name="Print View" procedure="PrintView">Shows the standard Print dialog to set where to print the current diagram or text view</command>
			<command name="Save Diagram" procedure="SaveDiagram">Saves the current diagram as an image file</command>
			<command name="Print Diagram" procedure="PrintDiagram">Prints the current diagram</command>
			<command name="Print Text" procedure="PrintText">Prints the current text view</command>

			<command name="View Source File" procedure="ViewSourceFile" browse="true">Opens a source (text) file for viewing</command>
			<command name="Open Text Editor" procedure="OpenTextEditor" browse="true">Opens the external Text Editor (specified in the Preferences/Options dialog)</command>
			<command name="Show Options" procedure="ShowOptions" browse="true">Opens the Preferences/Options dialog</command>
			<command name="Clear Application History" procedure="ClearApplicationHistory">Clears the history list of recent applications</command>
			<command name="Exit Application" procedure="ExitApp" browse="true">Exits ESL-Studio</command>

			<command name="Undo" procedure="Undo">Undoes the last editing action</command>
			<command name="Redo" procedure="Redo">Redoes the previously undone action</command>
			<command name="Cut" procedure="CanvasAction">Cuts the selection and moves it to the clipboard
				<info action="Cut"/>
			</command>
			<command name="Copy" procedure="CanvasAction">Copies the selection to the clipboard
				<info action="Copy"/>
			</command>
			<command name="Paste" procedure="CanvasAction">Pastes the clipboard contents onto the canvas
				<info action="Paste"/>
			</command>
			<command name="Delete" procedure="CanvasAction">Deletes the current selection
				<info action="Delete"/>
			</command>
			<command name="Select All" procedure="CanvasAction">Selects all objects
				<info action="Select All"/>
			</command>
			<command name="Flip Left/Right" procedure="CanvasAction">Flips the selected diagram objects horizontally
				<info action="FlipLR"/>
			</command>
			<command name="Flip Up/Down" procedure="CanvasAction">Flips the selected diagram objects vertically
				<info action="FlipUD"/>
			</command>
			<command name="Rotate Left 90 degrees" procedure="CanvasAction">Rotates the selected diagram objects 90 degrees left
				<info action="RotateLeft90"/>
			</command>
			<command name="Rotate 180 degrees" procedure="CanvasAction">Rotates the selected objects 180 degrees
				<info action="Rotate180"/>
			</command>
			<command name="Rotate Right 90 degrees" procedure="CanvasAction">Rotates the selected diagram objects 90 degrees right
				<info action="RotateRight90"/>
			</command>

			<command name="Toggle Toolbar" procedure="ToggleView" browse="true">Shows/hides the toolbar
				<info checkable="true" viewname="Toolbar"/>
			</command>
			<command name="Toggle Application View" procedure="ToggleView" browse="true">Shows/hides the Application pane - the tree view of the application
				<info checkable="true" viewname="ApplicationView"/>
			</command>
			<command name="Toggle Elements View" procedure="ToggleView" browse="true">Shows/hides the Elements pane - the available simulation elements
				<info checkable="true" viewname="ElementsView"/>
			</command>
			<command name="Toggle Messages View" procedure="ToggleView" browse="true">Shows/hides the Messages pane - the message display area
				<info checkable="true" viewname="MessagesView"/>
			</command>
			<command name="Toggle Properties View" procedure="ToggleView" browse="true">Shows/hides the Properties pane - to edit current view or selection properties
				<info checkable="true" viewname="PropertiesView"/>
			</command>
			<command name="Toggle Simulation Parameters View" procedure="ToggleView" browse="true">Shows/hides the model's Simulation Parameters view - to determine the simulation execution mechanism
				<info checkable="true" viewname="SimulationParametersView"/>
			</command>
			<command name="Toggle Simulation Setup View" procedure="ToggleView" browse="true">Shows/hides the simulation Setup view - to determine how the simulation will be built and invoked
				<info checkable="true" viewname="SetupView"/>
			</command>
			<command name="Clear Messages" procedure="ClearMessages">Clears the contents of the Messages pane</command>
			<command name="Zoom Dialog" procedure="ZoomDialog" browse="true">Opens the Zoom Settings dialog - to change the diagram zoom factor</command>
			<command name="Zoom Reset" procedure="CanvasAction" browse="true">Resets the diagram zoom factor to normal (100%)
				<info action="Set Scale" to="100"/>
			</command>
			<command name="Zoom All" procedure="ZoomAll" browse="true">Zooms the diagram to show all elements</command>
			<command name="Zoom Selected" procedure="ZoomSelected" browse="true">Zooms the diagram to show all selected elements</command>


			<command name="Insert Model Diagram" procedure="InsertModelDiagram">Inserts a new model diagram view into the application</command>
			<command name="Insert Submodel Diagram" procedure="InsertSubmodelDiagram">Inserts a new submodel diagram view into the application</command>
			<command name="Insert Segment Diagram" procedure="InsertSegmentDiagram">Inserts a new segment diagram view into the application</command>
			<command name="Import ESL Code Subprograms" procedure="InsertESLCodeSubprograms">Imports new ESL textual (code) subprogram(s) into the application</command>
			<command name="Import File Code Subprograms" procedure="InsertFileCodeSubprograms">Imports new file textual (code) subprogram(s) into the application</command>
			<command name="Insert Package" procedure="InsertPackage">Inserts a new variables package view into the application</command>


			<command name="Run Simulation" procedure="RunSimulation">Builds and runs the ESL simulation for the application as defined in the Setup view</command>
			<command name="Launch ESL-SEC" procedure="LaunchESLSEC">Launch the ESL-SEC program - to run another simulation</command>
			<command name="Launch ESL-Displays" procedure="LaunchESLDisplays" browse="true">Launch the ESL-Displays program - for post run analysis</command>


			<command name="Show ESL-Studio Help" procedure="ShowHelp" browse="true">Displays the ESL-Studio web-pages (website)
				<info help="%ESL_STUDIO_URL%"/>
			</command>
			<command name="Show ESL Help" procedure="ShowHelp" browse="true">Displays the ESL Help file (installed locally)
				<info help="$ESLDIR/help/esl.html"/>
			</command>
			<command name="Show ESL Documents" procedure="ShowHelp" browse="true">Displays the ESL Documents (ESL Software website)
				<info help="%ESL_SOFTWARE_URL%/documents/"/>
			</command>

			<command name="Check ESL-Studio Updates" procedure="CheckESLStudioUpdates" browse="true">Checks ESL Software for any updates to this version of ESL-Studio</command>
			<command name="Check ESL Updates" procedure="CheckESLUpdates" browse="true">Checks ESL Software for any updates to the current version of ESL</command>
			<command name="Show About Box" procedure="ShowAboutBox" browse="true">Shows information about ESL-Studio (version and licence)</command>


			<command name="Show Submodel" procedure="ShowSubprogram" browse="true">Shows submodel for a submodel call</command>
			<command name="Show Segment" procedure="ShowSubprogram" browse="true">Shows segment for a segment call</command>

		</commands>

	</esl-studio>

</esl-studio-std-commands>
